name: dockercompose12165813152283015696
services:
  angular-app:
    build:
      context: D:\MS\Thesis\Attemp_2\Asp.netCoreWithAngular\UI\SimpleBilling.web
      dockerfile: Dockerfile
    depends_on:
      simplebilling:
        condition: service_started
        required: true
    image: angular-app:latest
    networks:
      backend: null
    ports:
      - mode: ingress
        target: 80
        published: "8080"
        protocol: tcp
  db:
    environment:
      ACCEPT_EULA: "Y"
      MSSQL_TCP_PORT: "1433"
      SA_PASSWORD: 123+abc-456
    healthcheck:
      test:
        - CMD
        - /opt/mssql-tools/bin/sqlcmd
        - -S
        - localhost
        - -U
        - sa
        - -P
        - 123+abc-456
        - -Q
        - SELECT 1
      interval: 10s
      retries: 3
    image: mcr.microsoft.com/mssql/server:2019-latest
    networks:
      backend: null
    ports:
      - mode: ingress
        target: 1433
        published: "11433"
        protocol: tcp
    security_opt:
      - no-new-privileges:true
    volumes:
      - type: volume
        source: mssql-data
        target: /var/opt/mssql
        volume: {}
  simplebilling:
    build:
      context: D:\MS\Thesis\Attemp_2\Asp.netCoreWithAngular\API\SimpleBilling
      dockerfile: SimpleBilling/Dockerfile
      args:
        BUILD_CONFIGURATION: Release
      labels:
        com.microsoft.created-by: visual-studio
        com.microsoft.visual-studio.project-name: SimpleBilling
    container_name: SimpleBilling
    depends_on:
      db:
        condition: service_healthy
        required: true
    entrypoint:
      - dotnet
      - --roll-forward
      - Major
      - /VSTools/DistrolessHelper/DistrolessHelper.dll
      - --wait
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ASPNETCORE_Kestrel__Certificates__Default__Password: "121"
      ASPNETCORE_Kestrel__Certificates__Default__Path: /https/https-dev-cert.pfx
      ASPNETCORE_URLS: http://+:8080;https://+:8081
      ConnectionStrings__BillingDB: Server=db;Database=BillingDB;User Id=sa;Password=123+abc-456;TrustServerCertificate=True
    image: simplebilling:latest
    labels:
      com.microsoft.visual-studio.project-name: SimpleBilling
      com.microsoft.visualstudio.debuggee.arguments: ' --additionalProbingPath /.nuget/packages  "/app/SimpleBilling.dll"'
      com.microsoft.visualstudio.debuggee.killprogram: dotnet --roll-forward Major /VSTools/DistrolessHelper/DistrolessHelper.dll --stop dotnet
      com.microsoft.visualstudio.debuggee.program: dotnet
      com.microsoft.visualstudio.debuggee.workingdirectory: /app
    networks:
      backend: null
    ports:
      - mode: ingress
        target: 8080
        published: "8080"
        protocol: tcp
      - mode: ingress
        target: 8081
        published: "8081"
        protocol: tcp
    tty: true
    volumes:
      - type: bind
        source: D:\MS\Thesis\Attemp_2\Asp.netCoreWithAngular\API\SimpleBilling\https-dev-cert.pfx
        target: /https/https-dev-cert.pfx
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\anisu\vsdbg\vs2017u5
        target: /remote_debugger
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\anisu\AppData\Roaming\ASP.NET\Https
        target: /root/.aspnet/https
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\anisu\AppData\Roaming\ASP.NET\Https
        target: /home/app/.aspnet/https
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\anisu\AppData\Roaming\Microsoft\UserSecrets
        target: /root/.microsoft/usersecrets
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\anisu\AppData\Roaming\Microsoft\UserSecrets
        target: /home/app/.microsoft/usersecrets
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Program Files\Microsoft Visual Studio\2022\Community\MSBuild\Sdks\Microsoft.Docker.Sdk\tools\linux-x64\net8.0
        target: /VSTools
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Program Files\Microsoft Visual Studio\2022\Community\Common7\IDE\CommonExtensions\Microsoft\HotReload
        target: /HotReloadAgent
        read_only: true
        bind:
          create_host_path: true
networks:
  backend:
    name: dockercompose12165813152283015696_backend
    driver: bridge
volumes:
  mssql-data:
    name: dockercompose12165813152283015696_mssql-data
    driver: local