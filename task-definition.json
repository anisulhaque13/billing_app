{
    "family": "simplebilling-task",
    "containerDefinitions": [
        {
            "name": "angular-app",
            "image": "062983379312.dkr.ecr.eu-north-1.amazonaws.com/angular-app:latest",
            "cpu": 256,
            "memory": 512,
            "portMappings": [
                {
                    "containerPort": 80,
                    "protocol": "tcp"
                }
            ],
            "essential": true,
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/simplebilling",
                    "awslogs-region": "eu-north-1",
                    "awslogs-stream-prefix": "angular-app"
                }
            }
        },
        {
            "name": "db",
            "image": "062983379312.dkr.ecr.eu-north-1.amazonaws.com/db:latest",
            "cpu": 512,
            "memory": 3072,
            "portMappings": [
                {
                    "containerPort": 1433,
                    "protocol": "tcp"
                }
            ],
            "essential": true,
            "environment": [
                {
                    "name": "SA_PASSWORD",
                    "value": "123+abc-456"
                },
                {
                    "name": "ACCEPT_EULA",
                    "value": "Y"
                }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/simplebilling",
                    "awslogs-region": "eu-north-1",
                    "awslogs-stream-prefix": "db"
                }
            },
"healthCheck": {
               "command": [
                    "CMD-SHELL",
                    "/opt/mssql-tools18/bin/sqlcmd -C -S 127.0.0.1 -U sa -P '123+abc-456' -Q 'SELECT 1'"
                ],
    "interval": 60,
    "timeout": 30,
    "retries": 5
}

        },
        {
            "name": "simplebilling",
            "image": "062983379312.dkr.ecr.eu-north-1.amazonaws.com/simplebilling:latest",
            "cpu": 512,
            "memory": 1024,
            "portMappings": [
                {
                    "containerPort": 8080,
                    "protocol": "tcp"
                }
            ],
            "essential": true,
            "environment": [
                {
                    "name": "ConnectionStrings__DefaultConnection",
                    "value": "Server=db,1433;Database=BillingDB;User Id=sa;Password=123+abc-456;TrustServerCertificate=True;"
                }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/simplebilling",
                    "awslogs-region": "eu-north-1",
                    "awslogs-stream-prefix": "simplebilling"
                }
            },
            "dependsOn": [
                {
                    "containerName": "db",
                    "condition": "HEALTHY"
                }
            ]
        }
    ],
    "executionRoleArn": "arn:aws:iam::062983379312:role/ecsTaskExecutionRole",
    "networkMode": "awsvpc",
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "4096",
    "memory": "8192",
    "volumes": []
}
