{
    "family": "simplebilling-task",
    "containerDefinitions": [
        {
            "name": "angular-app",
            "image": "062983379312.dkr.ecr.eu-north-1.amazonaws.com/angular-app:latest",
            "cpu": 256,
            "memory": 512,
            "portMappings": [
                {
                    "containerPort": 80,
                    "protocol": "tcp"
                }
            ],
            "essential": true,
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/simplebilling",
                    "awslogs-region": "eu-north-1",
                    "awslogs-stream-prefix": "angular-app"
                }
            }
        },
        {
            "name": "db",
            "image": "062983379312.dkr.ecr.eu-north-1.amazonaws.com/db:latest",
            "cpu": 512,
            "memory": 3072,
            "portMappings": [
                {
                    "containerPort": 1433,
                    "protocol": "tcp"
                }
            ],
            "essential": true,
            "environment": [
                {
                    "name": "SA_PASSWORD",
                    "value": "123+abc-456"
                },
                {
                    "name": "ACCEPT_EULA",
                    "value": "Y"
                }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/simplebilling",
                    "awslogs-region": "eu-north-1",
                    "awslogs-stream-prefix": "db"
                }
            },
            "healthCheck": {
                "command": ["CMD-SHELL", "/opt/mssql-tools/bin/sqlcmd -S localhost -U sa -P '123+abc-456' -Q 'SELECT 1'"],
                "interval": 60,
                "timeout": 30,
                "retries": 5
            }
        }    ],
    "executionRoleArn": "arn:aws:iam::062983379312:role/ecsTaskExecutionRole",
    "networkMode": "awsvpc",
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "4096",
    "memory": "8192",
    "volumes": []
}
