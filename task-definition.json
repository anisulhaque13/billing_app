{
    "family": "simplebilling-task",
    "containerDefinitions": [
        {
            "name": "angular-app",
            "image": "062983379312.dkr.ecr.eu-north-1.amazonaws.com/angular-app:latest",
            "cpu": 256,
            "memory": 512,
            "portMappings": [
                {
                    "containerPort": 80,
                    "hostPort": 80,
                    "protocol": "tcp"
                }
            ],
            "essential": true,
            "environment": [],
            "mountPoints": [],
            "volumesFrom": [],
            "systemControls": []
        },
        {
            "name": "simplebilling",
            "image": "062983379312.dkr.ecr.eu-north-1.amazonaws.com/simplebilling:latest",
            "cpu": 256,
            "memory": 512,
            "portMappings": [
                {
                    "containerPort": 8080,
                    "hostPort": 8080,
                    "protocol": "tcp"
                },
                {
                    "containerPort": 8081,
                    "hostPort": 8081,
                    "protocol": "tcp"
                }
            ],
            "essential": true,
            "environment": [
                {
                    "name": "ConnectionStrings__BillingDB",
                    "value": "Server=db;Database=BillingDB;User Id=sa;Password=123+abc-456;TrustServerCertificate=True"
                }
            ],
            "mountPoints": [],
            "volumesFrom": [],
            "systemControls": []
        },
        {
            "name": "db",
            "image": "062983379312.dkr.ecr.eu-north-1.amazonaws.com/db",
            "cpu": 512,
            "memory": 1024,
            "portMappings": [
                {
                    "containerPort": 1433,
                    "hostPort": 1433,
                    "protocol": "tcp"
                }
            ],
            "essential": true,
            "environment": [
                {
                    "name": "SA_PASSWORD",
                    "value": "123+abc-456"
                },
                {
                    "name": "ACCEPT_EULA",
                    "value": "Y"
                }
            ],
            "mountPoints": [],
            "volumesFrom": [],
            "systemControls": []
        }
    ],
    "taskRoleArn": "arn:aws:iam::062983379312:role/ecsTaskExecutionRole",
    "executionRoleArn": "arn:aws:iam::062983379312:role/ecsTaskExecutionRole",
    "networkMode": "awsvpc",
    "volumes": [],
    "placementConstraints": [],
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "1024",
    "memory": "2048"
}