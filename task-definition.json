{
    "family": "simplebilling-task",
    "containerDefinitions": [
        {
            "name": "angular-app",
            "image": "062983379312.dkr.ecr.eu-north-1.amazonaws.com/angular-app:latest",
            "cpu": 0,
            "portMappings": [
                {
                    "containerPort": 80,
                    "hostPort": 80,
                    "protocol": "tcp"
                }
            ],
            "essential": true,
            "environment": [],
            "mountPoints": [],
            "volumesFrom": [],
            "systemControls": []
        },
        {
            "name": "simplebilling",
            "image": "062983379312.dkr.ecr.eu-north-1.amazonaws.com/simplebilling:latest",
            "cpu": 0,
            "portMappings": [
                {
                    "containerPort": 8080,
                    "hostPort": 8080,
                    "protocol": "tcp"
                },
                {
                    "containerPort": 8081,
                    "hostPort": 8081,
                    "protocol": "tcp"
                }
            ],
            "essential": true,
            "environment": [
                {
                    "name": "ConnectionStrings__DefaultConnection",
                    "value": "Server=db,1433;Database=YourDatabaseName;User Id=sa;Password=123+abc-456;"
                }
            ],
            "mountPoints": [],
            "volumesFrom": [],
            "systemControls": []
        },
        {
            "name": "db",
            "image": "062983379312.dkr.ecr.eu-north-1.amazonaws.com/db:latest",
            "cpu": 0,
            "portMappings": [
                {
                    "containerPort": 1433,
                    "hostPort": 1433,
                    "protocol": "tcp"
                }
            ],
            "essential": true,
            "environment": [
                {
                    "name": "SA_PASSWORD",
                    "value": "123+abc-456"
                },
                {
                    "name": "ACCEPT_EULA",
                    "value": "Y"
                }
            ],
            "mountPoints": [],
            "volumesFrom": [],
            "systemControls": []
        }
    ],
    "executionRoleArn": "arn:aws:iam::062983379312:role/ecsTaskExecutionRole",
    "networkMode": "awsvpc",
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "2048",
    "memory": "4096",
    "volumes": []
}
