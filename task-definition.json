{
  "family": "simplebilling-task",
  "networkMode": "awsvpc",
  "containerDefinitions": [
    {
      "name": "angular-app",
      "image": "<ECR_REPOSITORY_ANGULAR>:latest",
      "memory": 512,
      "cpu": 256,
      "essential": true,
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 7000
        }
      ]
    },
    {
      "name": "simplebilling",
      "image": "<ECR_REPOSITORY_SIMPLEBILLING>:latest",
      "memory": 512,
      "cpu": 256,
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 5000
        },
        {
          "containerPort": 8081,
          "hostPort": 5001
        }
      ],
      "environment": [
        {
          "name": "ConnectionStrings__BillingDB",
          "value": "Server=db;Database=BillingDB;User Id=sa;Password=123+abc-456;TrustServerCertificate=True"
        }
      ]
    },
    {
      "name": "db",
      "image": "<ECR_REPOSITORY_DB>:latest",
      "memory": 1024,
      "cpu": 512,
      "essential": true,
      "portMappings": [
        {
          "containerPort": 1433,
          "hostPort": 1433
        }
      ],
      "environment": [
        {
          "name": "ACCEPT_EULA",
          "value": "Y"
        },
        {
          "name": "SA_PASSWORD",
          "value": "123+abc-456"
        }
      ]
    }
  ],
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::062983379312:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::062983379312:role/ecsTaskExecutionRole"
}
