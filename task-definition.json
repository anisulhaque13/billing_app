{
  "family": "simplebilling-task",
  "networkMode": "awsvpc",
  "executionRoleArn": "arn:aws:iam::062983379312:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "angular-app",
      "image": "062983379312.dkr.ecr.eu-north-1.amazonaws.com/angular-app:latest",
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp"
        }
      ]
    },
    {
      "name": "simplebilling",
      "image": "062983379312.dkr.ecr.eu-north-1.amazonaws.com/simplebilling:latest",
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp"
        }
      ],
            "essential": true,
            "environment": [
                {
                    "name": "ConnectionStrings__BillingDB",
                    "value": "Server=db;Database=BillingDB;User Id=sa;Password=123+abc-456;TrustServerCertificate=True"
                }
            ]

    },
    {
      "name": "db",
      "image": "062983379312.dkr.ecr.eu-north-1.amazonaws.com/db:latest",
      "portMappings": [
        {
          "containerPort": 1433,
          "hostPort": 1433,
          "protocol": "tcp"
        }
      ],
            "essential": true,
            "environment": [
                {
                    "name": "SA_PASSWORD",
                    "value": "123+abc-456"
                },
                {
                    "name": "ACCEPT_EULA",
                    "value": "Y"
                }
            ]
    }
  ],
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "2048",
  "memory": "4096",
  "networkConfiguration": {
    "awsvpcConfiguration": {
      "subnets": ["subnet-026f9eef95e965ca0", "subnet-0eacb8c61b96d86d2"],
      "securityGroups": ["sg-0781118814f98a4d7"],
      "assignPublicIp": "ENABLED"
    }
  }
}
